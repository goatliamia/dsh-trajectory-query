    "self-test.mjs"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "session",
    "trajectory",
    "query"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goatliamia/dsh-trajectory-query.git"
  },
  "engines": {
