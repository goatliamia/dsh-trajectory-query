{
  "name": "dsh-trajectory-tools",
  "version": "0.4.0",
  "description": "面向模型的会话轨迹查询与诊断取证：逐字检索、窗口、关系链及官方统计证据。只读，不改写日志；附带可选的压缩后对账。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "self-test.mjs",
    "inspect-test.mjs"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "session",
    "trajectory",
    "query"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goatliamia/dsh-trajectory-query.git"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-token-meter": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
