{
  "name": "dsh-analysis-view",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "常驻分析 tab:复用 conversation 视图框架,注册 uiConversation.views target 'analysis' + conversation.view occupant,消费 useTrajectory 投影的确定性 digest",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/client.js",
    "lib/index.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
