{
  "name": "dsh-analysis-view",
  "version": "0.10.36",
  "private": true,
  "type": "module",
  "description": "「分析」标签与执行路径页:Geist 视觉、上下文层、文件层、子代理与 Skill 观察",
  "main": "lib/index.js",
  "scripts": { "prepack": "node ../../scripts/sync-view-assets.mjs" },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/client.js",
    "lib/index.js",
    "lib/incident-shape.js",
    "lib/trace-build.js",
    "lib/trace-cache.js",
    "lib/trace-stages.js",
    "lib/trace-resources.js",
    "lib/trace-context.js",
    "lib/trace-skill-evidence.js",
    "lib/trace",
    "cordis.patch.yml",
    "README.md",
    "self-test.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  },
  "license": "MIT"
}
