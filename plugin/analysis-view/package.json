{
  "name": "dsh-analysis-view",
  "version": "0.3.19",
  "private": true,
  "type": "module",
  "description": "「分析」标签:当前会话的轮次、花费、工具、incident,以及一次按需解读",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/client.js",
    "lib/index.js",
    "lib/incident-shape.js",
    "cordis.patch.yml",
    "README.md",
    "self-test.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
